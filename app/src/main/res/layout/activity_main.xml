<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view" />

    <FrameLayout
        android:id="@+id/wait_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000A1E"
        android:visibility="gone">

        <com.tvoynatici.app.ParticleView
            android:id="@+id/wait_particles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.tvoynatici.app.WaveView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/wait_logo"
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="Ruha TV"
                android:src="@drawable/logo_tr" />

            <TextView
                android:id="@+id/wait_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Yayın yeniden bağlanıyor…"
                android:textColor="#1DE9D0"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Lütfen bekleyin"
                android:textColor="#99FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/live_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@drawable/bg_live"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="●  CANLI"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:alpha="0"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/touch_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/chip_news"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingTop="7dp"
            android:paddingRight="18dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/chip_news_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:text="▲"
                android:textColor="#E8363F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="64dp"
                android:layout_height="30dp"
                android:contentDescription="Urfa Haber"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_urfahaber" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chip_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_chip"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="18dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/chip_video_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="◀"
                android:textColor="#FF0000"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="26dp"
                android:contentDescription="YouTube"
                android:src="@drawable/ic_yt_badge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="7dp"
                android:letterSpacing="-0.03"
                android:text="YouTube"
                android:textColor="#0F0F0F"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>


        <TextView
            android:id="@+id/aspect_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Sığdır ▾"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/aspect_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="66dp"
            android:background="@drawable/bg_menu"
            android:columnCount="2"
            android:padding="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btn_pip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle"
                android:clickable="true"
                android:contentDescription="Mini oynatıcı"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_pip" />
            <ImageView
                android:id="@+id/btn_social"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle"
                android:clickable="true"
                android:contentDescription="Sosyal medya"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_heart" />
            <ImageView
                android:id="@+id/btn_info"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle"
                android:clickable="true"
                android:contentDescription="Bilgi"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_info" />
            <ImageView
                android:id="@+id/btn_volume"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle"
                android:clickable="true"
                android:contentDescription="Ses"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_volume" />
            <ImageView
                android:id="@+id/btn_mute"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_circle"
                android:clickable="true"
                android:contentDescription="Sesi kapat"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_volume_off" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/info_overlay"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000A1E"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/info_card"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="120dp"
            android:layout_marginRight="120dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="56dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="40dp">

            <ImageView
                android:id="@+id/info_logo"
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:adjustViewBounds="true"
                android:contentDescription="Ruha TV"
                android:src="@drawable/logo_tr" />

            <TextView
                android:id="@+id/info_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#1DE9D0"
                android:textSize="34sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#331DE9D0" />

            <ScrollView
                android:id="@+id/info_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/info_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />
            </ScrollView>

            <TextView
                android:id="@+id/info_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:text="OK / Geri: Kapat      ▲ ▼: Kaydır"
                android:textColor="#99FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/info_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="44dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/bg_circle"
            android:clickable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/social_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000A1E"
        android:clickable="true"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/social_wrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/social_card"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center_horizontal"
                        android:adjustViewBounds="true"
                        android:contentDescription="Ruha TV"
                        android:src="@drawable/logo_tr" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Bizi Takip Edin"
                        android:textColor="#1DE9D0"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Bir hesaba dokunun, bizi takip edin"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/social_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_track">

                        <View
                            android:id="@+id/social_bar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_progress" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/splash_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000A1E">

        <ImageView
            android:id="@+id/splash_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ruha TV"
            android:scaleType="centerCrop"
            android:src="@drawable/splash" />

        <com.tvoynatici.app.ParticleView
            android:id="@+id/splash_particles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="70dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/splash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yayın hazırlanıyor…"
                android:textColor="#1DE9D0"
                android:textSize="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_track">

                <View
                    android:id="@+id/splash_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <com.tvoynatici.app.VolumeRingView
        android:id="@+id/volume_ring"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:alpha="0" />
</FrameLayout>
