<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view" />

    <TextView
        android:id="@+id/live_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@drawable/bg_live"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="●  CANLI"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:alpha="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_pill"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Bağlantı yeniden deneniyor…"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/info_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000A1E"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="120dp"
            android:layout_marginRight="120dp"
            android:layout_marginTop="56dp"
            android:layout_marginBottom="56dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="40dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="80dp"
                android:adjustViewBounds="true"
                android:contentDescription="Ruha TV"
                android:src="@drawable/logo_tr" />

            <TextView
                android:id="@+id/info_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#1DE9D0"
                android:textSize="34sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#331DE9D0" />

            <ScrollView
                android:id="@+id/info_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/info_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp" />
            </ScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:text="OK / Geri: Kapat      ▲ ▼: Kaydır"
                android:textColor="#99FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/splash_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000A1E">

        <ImageView
            android:id="@+id/splash_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ruha TV"
            android:scaleType="centerCrop"
            android:src="@drawable/splash" />

        <com.tvoynatici.app.ParticleView
            android:id="@+id/splash_particles"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="70dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/splash_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yayın hazırlanıyor…"
                android:textColor="#1DE9D0"
                android:textSize="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_track">

                <View
                    android:id="@+id/splash_progress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_progress" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <com.tvoynatici.app.VolumeRingView
        android:id="@+id/volume_ring"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:alpha="0" />
</FrameLayout>
