<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#3D1DE9D0" android:endColor="#240A9AD6" android:angle="315" />
            <corners android:radius="26dp" />
            <stroke android:width="3dp" android:color="#1DE9D0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#3D1DE9D0" android:endColor="#240A9AD6" android:angle="315" />
            <corners android:radius="26dp" />
            <stroke android:width="3dp" android:color="#1DE9D0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="26dp" />
            <stroke android:width="1.5dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>
